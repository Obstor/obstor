{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": { "ignoreUnknown": false, "includes": ["**", "!pnpm-lock.yaml", "!**/.pnpm-store"] },
  "formatter": {
    "enabled": true,
    "includes": ["**"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox"] }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "preset": "recommended"
    }
  },
  "tailwind": { "mergeFunctions": ["clsx", "cn"], "variantFunctions": ["cva"] }
}
